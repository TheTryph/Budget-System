local process = require("@lune/process")
local fs = require("@lune/fs")
local serde = require("@lune/serde")

local commitizen_generated_file = fs.readFile(".cz.json")
local commitizen_version_structure = serde.decode("json", commitizen_generated_file)

fs.writeFile("src/build_info.luau", string.format([[
    -- This is auto generated by the build system. Do not modify
    return {
        date = %d,
        version = "%s"
    }
]], os.time(), commitizen_version_structure.commitizen.version))

process.exec("darklua", {"process", "src/main.luau", "processed.luau"})
process.exec("lune", {"build", "processed.luau", "-o", "build/bin.exe"})
fs.removeFile("processed.luau")